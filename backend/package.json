{
  "name": "ezshell-backend",
  "version": "1.0.0",
  "description": "This is the backend of ezshell app @ eZetsu",
  "main": "server.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "tsc",
    "dev": "ts-node-dev src/server.ts --env-file=.env",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "docker:build": "docker build -t ezshell-backend -f Dockerfile.backend .",
    "docker:run": "docker run -p 3001:3001 ezshell-backend"
  },
  "keywords": [
    "ezshell",
    "zetsu",
    "devops"
  ],
  "author": "Edilson D Mucanze",
  "license": "ISC",
  "devDependencies": {
    "@types/babel__template": "^7.4.4",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/ssh2": "^1.15.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.28.1",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.7.1",
    "typescript": "^5.5.4",
    "uuid": "^11.1.0"
  },
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.5.4",
    "axios": "^1.9.0",
    "drizzle-orm": "^0.40.1",
    "drizzle-zod": "^0.7.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "node-pty": "^1.0.0",
    "node-ssh": "^13.2.0",
    "postgres": "^3.4.5",
    "socket.io": "^4.7.5",
    "ssh2": "^1.15.0",
    "zod": "^3.22.4"
  }
}
