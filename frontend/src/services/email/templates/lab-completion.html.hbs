<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lab Completed - Congratulations!</title>
    <!--[if mso]>
    <noscript>
        <xml>
            <o:OfficeDocumentSettings>
                <o:PixelsPerInch>96</o:PixelsPerInch>
            </o:OfficeDocumentSettings>
        </xml>
    </noscript>
    <![endif]-->
</head>
<body style="margin: 0; padding: 0; background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="width: 100%; background-color: #f8f9fa;">
        <tr>
            <td align="center" style="padding: 20px;">
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="width: 100%; max-width: 600px; background-color: white; border-radius: 8px; border: 1px solid #e5e7eb;">
                    <!-- Header -->
                    <tr>
                        <td style="background-color: #7c3aed; padding: 40px 30px; text-align: center; position: relative;">
                            <h1 style="font-size: 32px; font-weight: 700; margin: 0 0 8px 0; color: white;">
                                🎉 Congratulations!
                            </h1>
                            <p style="font-size: 18px; margin: 0; color: white; opacity: 0.9;">
                                You've successfully completed your lab
                            </p>
                        </td>
                    </tr>

                    <!-- Main Content -->
                    <tr>
                        <td style="padding: 40px 30px 0 30px;">
                            <div style="font-size: 18px; font-weight: 600; color: #1f2937; margin-bottom: 20px;">
                                Hello {{userName}},
                            </div>
                            <p style="font-size: 16px; color: #374151; line-height: 1.7; margin: 0 0 25px 0;">
                                Excellent work! You have successfully completed <strong>{{labName}}</strong>.
                                Your dedication to hands-on learning and problem-solving has paid off.
                            </p>
                        </td>
                    </tr>

                    <!-- Lab Results Card -->
                    <tr>
                        <td style="padding: 0 30px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="width: 100%; background-color: #f0fdf4; border-left: 4px solid #22c55e; border-radius: 0 8px 8px 0;">
                                <tr>
                                    <td style="padding: 25px;">
                                        <div style="font-size: 20px; font-weight: 700; color: #16a34a; margin-bottom: 8px;">
                                            Lab Completion Summary
                                        </div>
                                        <div style="font-size: 16px; color: #374151; margin-bottom: 15px;">
                                            {{labDescription}}
                                        </div>

                                        <!-- Results Grid -->
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="width: 100%;">
                                            <tr>
                                                <td style="width: 48%; vertical-align: top; padding-right: 7px;">
                                                    <div style="font-size: 12px; font-weight: 600; text-transform: uppercase; color: #6b7280; margin-bottom: 4px;">
                                                        Completion Date
                                                    </div>
                                                    <div style="font-size: 14px; font-weight: 600; color: #1f2937;">
                                                        {{completionDate}}
                                                    </div>
                                                </td>
                                                <td style="width: 48%; vertical-align: top; padding-left: 7px;">
                                                    <div style="font-size: 12px; font-weight: 600; text-transform: uppercase; color: #6b7280; margin-bottom: 4px;">
                                                        Time Spent
                                                    </div>
                                                    <div style="font-size: 14px; font-weight: 600; color: #1f2937;">
                                                        {{timeSpent}}
                                                    </div>
                                                </td>
                                            </tr>
                                        </table>

                                        {{#if score}}
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="width: 100%; margin-top: 15px;">
                                            <tr>
                                                <td style="width: 48%; vertical-align: top; padding-right: 7px;">
                                                    <div style="font-size: 12px; font-weight: 600; text-transform: uppercase; color: #6b7280; margin-bottom: 4px;">
                                                        Score
                                                    </div>
                                                    <div style="font-size: 14px; font-weight: 600; color: #1f2937;">
                                                        {{score}}%
                                                    </div>
                                                </td>
                                                <td style="width: 48%; vertical-align: top; padding-left: 7px;">
                                                    <div style="font-size: 12px; font-weight: 600; text-transform: uppercase; color: #6b7280; margin-bottom: 4px;">
                                                        Status
                                                    </div>
                                                    <div style="font-size: 14px; font-weight: 600; color: #16a34a;">
                                                        ✅ Completed
                                                    </div>
                                                </td>
                                            </tr>
                                        </table>
                                        {{/if}}
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Certificate/Achievement Section -->
                    {{#if certificateUrl}}
                    <tr>
                        <td style="padding: 30px; text-align: center;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 0 auto;">
                                <tr>
                                    <td style="background-color: #7c3aed; border-radius: 8px; padding: 15px 30px;">
                                        <a href="{{certificateUrl}}" style="display: inline-block; color: white; text-decoration: none; font-weight: 600; font-size: 16px;">
                                            📜 Download Certificate
                                        </a>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    {{/if}}

                    <!-- Next Steps Section -->
                    <tr>
                        <td style="padding: 0 30px 30px 30px;">
                            <p style="font-size: 16px; color: #374151; line-height: 1.7; margin: 0 0 20px 0;">
                                <strong>What's Next?</strong><br>
                                • Review your lab notes and solutions<br>
                                • Explore related labs to build on your skills<br>
                                • Share your achievement with your network<br>
                                {{#if nextLabSuggestion}}
                                • Consider trying "{{nextLabSuggestion}}" for your next challenge
                                {{/if}}
                            </p>

                            <!-- Divider -->
                            <div style="height: 1px; background-color: #e5e7eb; margin: 25px 0;"></div>

                            <p style="font-size: 16px; color: #374151; line-height: 1.7; margin: 0;">
                                <strong>Share Your Success:</strong> Don't forget to add this accomplishment to your professional profile
                                and share your learning journey with colleagues and friends!
                            </p>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="padding: 30px; background-color: #f9fafb; border-top: 1px solid #e5e7eb; text-align: center;">
                            <div style="font-size: 24px; font-weight: 800; color: #7c3aed; margin-bottom: 10px;">
                                🚀 {{companyName}}
                            </div>
                            <p style="font-size: 14px; color: #6b7280; line-height: 1.6; margin: 0 0 15px 0;">
                                Celebrating your commitment to continuous learning and growth.
                            </p>
                            <p style="font-size: 14px; color: #6b7280; margin: 0 0 10px 0;">
                                Questions? Contact us at <a href="mailto:{{supportEmail}}" style="color: #7c3aed; text-decoration: none;">{{supportEmail}}</a>
                            </p>
                            <p style="font-size: 12px; color: #6b7280; margin: 0;">
                                © {{currentYear}} {{companyName}}. All rights reserved.
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
            position: absolute;
            top: 15px;
            left: 20px;
            font-size: 24px;
            animation: bounce 2s infinite;
        }
        .celebration-banner::after {
            content: '🎊';
            position: absolute;
            top: 15px;
            right: 20px;
            font-size: 24px;
            animation: bounce 2s infinite 0.5s;
        }
        .lab-name {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 15px;
        }
        .completion-badge {
            background-color: rgba(255, 255, 255, 0.2);
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: bold;
            display: inline-block;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 20px;
            margin: 25px 0;
        }
        .stat-card {
            background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
            padding: 20px;
            border-radius: 8px;
            text-align: center;
            border: 2px solid #e2e8f0;
        }
        .stat-number {
            font-size: 24px;
            font-weight: bold;
            color: #2563eb;
            margin-bottom: 5px;
        }
        .stat-label {
            font-size: 14px;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .achievement-section {
            background-color: #fef3c7;
            border: 1px solid #f59e0b;
            border-radius: 8px;
            padding: 20px;
            margin: 25px 0;
        }
        .achievement-title {
            color: #92400e;
            font-weight: bold;
            margin-bottom: 15px;
            font-size: 18px;
        }
        .achievement-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        .achievement-list li {
            color: #92400e;
            margin-bottom: 8px;
            padding-left: 25px;
            position: relative;
        }
        .achievement-list li::before {
            content: '🏆';
            position: absolute;
            left: 0;
        }
        .next-steps {
            background-color: #ecfdf5;
            border: 1px solid #10b981;
            border-radius: 8px;
            padding: 20px;
            margin: 25px 0;
        }
        .next-steps h3 {
            color: #065f46;
            margin-top: 0;
        }
        .cta-button {
            display: inline-block;
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
            padding: 15px 30px;
            text-decoration: none;
            border-radius: 8px;
            font-weight: bold;
            text-align: center;
            margin: 15px 0;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
        }
        .footer {
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid #e5e7eb;
            font-size: 14px;
            color: #6b7280;
            text-align: center;
        }
        @keyframes bounce {
            0%, 20%, 53%, 80%, 100% {
                transform: translate3d(0,0,0);
            }
            40%, 43% {
                transform: translate3d(0,-15px,0);
            }
            70% {
                transform: translate3d(0,-7px,0);
            }
            90% {
                transform: translate3d(0,-2px,0);
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="logo">🚀 {{companyName}}</div>
            <h1 class="title">🎉 Congratulations!</h1>
        </div>

        <div class="content">
            <p>Hi {{userName}},</p>

            <p>Outstanding work! You have successfully completed your lab and demonstrated excellent skills in hands-on learning.</p>

            <div class="celebration-banner">
                <div class="lab-name">{{labName}}</div>
                {{#if labDescription}}
                <p style="margin: 10px 0; opacity: 0.9; font-size: 16px;">{{labDescription}}</p>
                {{/if}}
                <div class="completion-badge">✅ Lab Completed</div>
            </div>

            {{#if score}}
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-number">{{score}}%</div>
                    <div class="stat-label">Final Score</div>
                </div>
                {{#if timeSpent}}
                <div class="stat-card">
                    <div class="stat-number">{{timeSpent}}</div>
                    <div class="stat-label">Time Spent</div>
                </div>
                {{/if}}
                {{#if tasksCompleted}}
                <div class="stat-card">
                    <div class="stat-number">{{tasksCompleted}}</div>
                    <div class="stat-label">Tasks Completed</div>
                </div>
                {{/if}}
            </div>
            {{/if}}

            {{#if achievements}}
            <div class="achievement-section">
                <div class="achievement-title">🏆 Your Achievements</div>
                <ul class="achievement-list">
                    {{#each achievements}}
                    <li>{{this}}</li>
                    {{/each}}
                </ul>
            </div>
            {{/if}}

            {{#if certificate}}
            <div class="next-steps">
                <h3>📜 Certificate Available</h3>
                <p>Your completion certificate is ready! Download it to showcase your newly acquired skills.</p>
                <a href="{{certificate.downloadUrl}}" class="cta-button">📥 Download Certificate</a>
            </div>
            {{/if}}

            {{#if feedback}}
            <div style="background-color: #f8fafc; padding: 20px; border-radius: 8px; margin: 25px 0;">
                <h3 style="margin-top: 0; color: #1f2937;">💭 Instructor Feedback</h3>
                <p style="font-style: italic; color: #4b5563; margin: 0;">"{{feedback}}"</p>
            </div>
            {{/if}}

            <div class="next-steps">
                <h3>🚀 What's Next?</h3>
                <p>Ready to continue your learning journey? Explore our other labs and courses to further develop your skills.</p>
                {{#if nextRecommendedLab}}
                <p><strong>Recommended next lab:</strong> {{nextRecommendedLab}}</p>
                {{/if}}
                <a href="{{dashboardUrl}}" class="cta-button">🎯 Explore More Labs</a>
            </div>

            <p>Thank you for choosing {{companyName}} for your learning journey. We're proud of your accomplishment!</p>
        </div>

        <div class="footer">
            <p>Share your achievement and inspire others!</p>
            <p>Need support? Contact us at <a href="mailto:{{supportEmail}}">{{supportEmail}}</a></p>
            <p>&copy; {{currentYear}} {{companyName}}. All rights reserved.</p>
        </div>
    </div>
</body>
</html>
