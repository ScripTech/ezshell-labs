<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to EZShell Labs</title>
    <!--[if mso]>
    <noscript>
        <xml>
            <o:OfficeDocumentSettings>
                <o:PixelsPerInch>96</o:PixelsPerInch>
            </o:OfficeDocumentSettings>
        </xml>
    </noscript>
    <![endif]-->
</head>
<body style="margin: 0; padding: 0; background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="width: 100%; background-color: #f8f9fa;">
        <tr>
            <td align="center" style="padding: 20px;">
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="width: 100%; max-width: 600px; background-color: white; border-radius: 8px; border: 1px solid #e5e7eb;">
                    <!-- Header -->
                    <tr>
                        <td style="padding: 40px 40px 30px 40px; text-align: center;">
                            <div style="font-size: 24px; font-weight: bold; color: #2563eb; margin-bottom: 10px;">
                                🚀 {{companyName}}
                            </div>
                            <h1 style="font-size: 28px; font-weight: bold; color: #1f2937; margin: 0;">
                                Welcome Aboard! 🎉
                            </h1>
                        </td>
                    </tr>

                    <!-- Main Content -->
                    <tr>
                        <td style="padding: 0 40px;">
                            <p style="font-size: 16px; color: #374151; line-height: 1.6; margin: 0 0 20px 0;">
                                Hi {{userName}},
                            </p>
                            <p style="font-size: 16px; color: #374151; line-height: 1.6; margin: 0 0 25px 0;">
                                Welcome to {{companyName}}! We're excited to have you join our community of learners and tech enthusiasts.
                            </p>
                            <p style="font-size: 16px; color: #374151; line-height: 1.6; margin: 0 0 30px 0;">
                                To get started with your hands-on learning journey, please verify your email address by clicking the button below:
                            </p>
                        </td>
                    </tr>

                    <!-- CTA Button -->
                    <tr>
                        <td style="padding: 0 40px; text-align: center;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 0 auto;">
                                <tr>
                                    <td style="background-color: #2563eb; border-radius: 8px; padding: 18px 36px;">
                                        <a href="{{verificationUrl}}" style="display: inline-block; color: white; text-decoration: none; font-weight: bold; font-size: 18px;">
                                            ✅ Verify Email Address
                                        </a>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Alternative Link -->
                    <tr>
                        <td style="padding: 25px 40px;">
                            <p style="font-size: 14px; color: #6b7280; text-align: center; margin: 0 0 15px 0;">
                                Or copy and paste this link into your browser:
                            </p>
                            <p style="font-size: 12px; color: #2563eb; text-align: center; margin: 0; word-break: break-all;">
                                {{verificationUrl}}
                            </p>
                        </td>
                    </tr>

                    <!-- Security Info -->
                    <tr>
                        <td style="padding: 0 40px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="width: 100%; background-color: #f0f9ff; border: 1px solid #bfdbfe; border-radius: 8px;">
                                <tr>
                                    <td style="padding: 20px;">
                                        <h3 style="font-size: 16px; font-weight: 600; color: #1e40af; margin: 0 0 10px 0;">
                                            🔒 Security Information
                                        </h3>
                                        <p style="font-size: 14px; color: #1e40af; margin: 0 0 10px 0;">
                                            This verification link will expire in 24 hours for security purposes.
                                        </p>
                                        <p style="font-size: 14px; color: #1e40af; margin: 0;">
                                            If you didn't create an account with us, please ignore this email.
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- What's Next -->
                    <tr>
                        <td style="padding: 30px 40px 0 40px;">
                            <h3 style="font-size: 18px; font-weight: 600; color: #1f2937; margin: 0 0 15px 0;">
                                🎯 What's Next?
                            </h3>
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="width: 100%;">
                                <tr><td style="font-size: 14px; color: #6b7280; padding: 3px 0;">📚 Explore our hands-on labs and courses</td></tr>
                                <tr><td style="font-size: 14px; color: #6b7280; padding: 3px 0;">🔧 Practice with real-world scenarios</td></tr>
                                <tr><td style="font-size: 14px; color: #6b7280; padding: 3px 0;">🏆 Track your progress and achievements</td></tr>
                                <tr><td style="font-size: 14px; color: #6b7280; padding: 3px 0;">🤝 Connect with fellow learners</td></tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="padding: 40px 40px 20px 40px; border-top: 1px solid #e5e7eb;">
                            <p style="font-size: 14px; color: #6b7280; text-align: center; margin: 0 0 10px 0;">
                                Need help? Contact us at <a href="mailto:{{supportEmail}}" style="color: #2563eb; text-decoration: none;">{{supportEmail}}</a>
                            </p>
                            <p style="font-size: 12px; color: #9ca3af; text-align: center; margin: 0;">
                                © {{currentYear}} {{companyName}}. All rights reserved.
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
