{
  "name": "ezshell-lab-provisioner",
  "version": "1.0.0",
  "description": "Lab provisioning microservice for EZShell Labs - handles AWS EC2 instance provisioning via Kafka messaging",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev src/index.ts --env-file=.env",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "docker:build": "docker build -t ezshell-lab-provisioner .",
    "docker:run": "docker run -p 3002:3002 ezshell-lab-provisioner"
  },
  "keywords": [
    "ezshell",
    "devops",
    "aws",
    "ec2",
    "kafka",
    "provisioning"
  ],
  "author": "EZShell Labs Team",
  "license": "ISC",
  "dependencies": {
    "aws-sdk": "^2.1467.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.28.6",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "kafka-node": "^5.0.0",
    "postgres": "^3.3.5",
    "uuid": "^9.0.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/joi": "^17.2.3",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.3",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
