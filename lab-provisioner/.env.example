# Lab Provisioner Environment Configuration
# Copy this file to .env and fill in your actual values

# Server Configuration
NODE_ENV=development
PORT=3002
LOG_LEVEL=info
LOG_DIR=../../logs

# Database Configuration (shared with main backend)
DATABASE_URL=postgresql://ezshell_user:ezshell_password_dev@localhost:5438/ezshell_labs

# Kafka Configuration
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=lab-provisioner
KAFKA_TOPIC=lab-enrollment
KAFKA_CONSUMER_GROUP=lab-provisioner-group

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# EC2 Configuration
AWS_INSTANCE_TYPE=t2.micro
AWS_AMI_ID=ami-0abcdef1234567890
AWS_SECURITY_GROUP_ID=sg-your_security_group_id
AWS_SUBNET_ID=subnet-your_subnet_id
AWS_KEY_PAIR_PREFIX=ezshell-lab
# AWS_IAM_INSTANCE_PROFILE=EC2-SSM-Role  # Optional: Comment out if not available

# SSH Key Management
SSH_KEY_DIR=./keys
SSH_KEY_PERMISSIONS=0o600

# Authentication (JWT shared secret with main backend)
JWT_SECRET=your_jwt_secret_here

# Provisioning Configuration
MAX_RETRY_ATTEMPTS=3
PROVISIONING_TIMEOUT=300000
INSTANCE_POLL_INTERVAL=5000

# Security
CORS_ORIGIN=http://localhost:3000
API_RATE_LIMIT=100
